{
  "name": "cedrouseroll",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Cedrouseroll Omondi",
    "email": "omondicedo@gmail.com",
    "url": "https://www.cedrouseroll.dev"
  },
  "scripts": {
    "build": "nuxt build",
    "bump": "bumpp --all --tag --commit \"chore(release): v%s\"",
    "changelog": "changelogen --from $(git describe --tags --abbrev=0 2>/dev/null || git rev-list --max-parents=0 HEAD) --output CHANGELOG.md",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "prepare": "husky",
    "release": "changelogen --release --from $(git describe --tags --abbrev=0 2>/dev/null || git rev-list --max-parents=0 HEAD) && pnpm bump"
  },
  "dependencies": {
    "@number-flow/vue": "^0.5.0",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.0.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxt/test-utils": "4.0.0",
    "@nuxtjs/supabase": "2.0.4",
    "@unhead/vue": "^2.1.12",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.0.3",
    "gsap": "^3.14.2",
    "lucide-vue-next": "^0.577.0",
    "mathjs": "^15.1.1",
    "motion-v": "^2.0.1",
    "nuxt": "^4.4.2",
    "reka-ui": "^2.9.2",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "bumpp": "^11.0.0",
    "changelogen": "^0.6.2",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "happy-dom": "^20.8.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "cz-git": {
    "disableEmoji": true
  }
}
